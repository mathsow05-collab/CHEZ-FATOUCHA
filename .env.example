# CHEZ FATOUCHA — configuration
# Copier ce fichier en `.env` (jamais commité) ou coller les valeurs dans Render → Environment.

# --- Serveur ---
PORT=3000

# Secret de signature des jetons admin (générer : openssl rand -hex 32)
JWT_SECRET=changez-moi-avec-un-secret-aleatoire

# --- Comptes administrateurs créés au PREMIER lancement ---
# ---- Espace vendeur : lien privé, rien n'y mène depuis la boutique ----
# Change-le si tu veux une URL encore moins évidente (lettres, chiffres, - et _).
# Le back-office ne se trouve PAS dans public/ : seule cette URL le sert.
CHEMIN_ADMIN=/gestion-fatou

ADMIN1_USERNAME=admin
ADMIN1_PASSWORD=changez-moi
# 2ᵉ compte optionnel (livreur / associé) — laisser vide pour n'en créer qu'un
ADMIN2_USERNAME=
ADMIN2_PASSWORD=

# --- Aperçu local uniquement (iframe d'un outil de dev) ---
# Ne JAMAIS mettre 1 en production : cela autorise l'affichage du site dans un iframe.
# ALLOW_FRAMES=1

# --- Données (à mettre sur un disque persistant en prod) ---
# Sans disque, la base et les photos sont effacées à chaque redéploiement (plan gratuit Render).
# DATA_DIR=/var/data/fatoucha
# UPLOADS_DIR=/var/data/fatoucha/uploads

# --- Paiement Wave / Orange Money ---
# auto    = CinetPay si les clés sont présentes (le client paie, la commande se valide seule)
#           sinon bascule automatiquement en mode manuel (envoi au numéro + validation admin)
# manuel  = force le mode manuel
# hybride = CinetPay avec repli manuel si l'agrégateur ne répond pas
PAYEMENT_MODE=auto
# Clés reçues quand tu ouvres un compte marchand CinetPay (https://www.cinetpay.com/)
CINETPAY_SITE_ID=
CINETPAY_API_KEY=
