{
  "name": "chez-fatoucha",
  "version": "1.0.0",
  "private": true,
  "description": "Boutique en ligne CHEZ FATOUCHA — catalogue, panier, livraison par zone, retrait boutique, paiement Wave / Orange Money",
  "engines": {
    "node": ">=20.0.0 <21.0.0"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "smoke": "node scripts/smoke-test.js",
    "test:front": "node scripts/front-test.js",
    "test": "npm run check:css && npm run smoke && npm run test:front",
    "demo:images": "node scripts/make-demo-images.js",
    "check:css": "node scripts/check-css.js",
    "build": "node scripts/check-css.js && node scripts/prepare-images.js",
    "images:prepare": "node scripts/prepare-images.js",
    "admin:reset": "node scripts/reset-admin.js"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "express": "^5.2.1",
    "multer": "^2.2.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.26"
  }
}
